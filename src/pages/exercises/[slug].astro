---
import Shell from '../../layouts/Shell.astro';
import PhotoFlip from '../../components/PhotoFlip.astro';
import { BY_SLUG, BUCKET_META, INTENSITIES, INTENSITY_META, isHoldRx } from '../../data/exercises';

const exercise = BY_SLUG.get(Astro.params.slug!);
if (!exercise) return Astro.redirect('/exercises', 302);

const amount = (i: (typeof INTENSITIES)[number]) => {
  const rx = exercise.rx[i];
  return isHoldRx(rx)
    ? `${rx.sets} × ${rx.seconds >= 60 ? `${Math.floor(rx.seconds / 60)}:${String(rx.seconds % 60).padStart(2, '0')}` : `${rx.seconds}s`}`
    : `${rx.sets} × ${rx.reps}`;
};
---

<Shell title={exercise.stage}>
  <div class="stack" style="--flow: 1.5rem">
    <header>
      <p class="eyebrow">{BUCKET_META[exercise.bucket].label} · {exercise.band}</p>
      <h1 class="display chrome">{exercise.stage}</h1>
      <p class="real-name" style="font-size: var(--step-1)">
        {exercise.real}{exercise.perSide ? ' · each side' : ''}
      </p>
    </header>

    <div style="max-width: 24rem">
      <PhotoFlip slug={exercise.slug} alt={`${exercise.real} demonstration`} width={1080} />
    </div>

    <section>
      <h2 class="eyebrow">How to do it</h2>
      <ul class="cues">{exercise.cues.map((c) => <li>{c}</li>)}</ul>
    </section>

    <section>
      <h2 class="eyebrow">Works</h2>
      <p class="muscles">{exercise.muscles.join(' · ')}</p>
    </section>

    <section>
      <h2 class="eyebrow">Prescription</h2>
      <ul class="rx">
        {INTENSITIES.map((i) => (
          <li><span class="meta">{INTENSITY_META[i].label}</span><b>{amount(i)}</b></li>
        ))}
      </ul>
    </section>

    <a class="btn btn-ghost" href="/exercises" style="width:100%">All tracks</a>
  </div>
</Shell>

<style>
  .cues { margin: .5rem 0 0; padding-left: 1.2rem; }
  .cues li + li { margin-top: .4rem; }
  .muscles { margin-top: .4rem; font-family: var(--font-mono); color: var(--acid); letter-spacing: .06em; }
  .rx { list-style: none; margin: .5rem 0 0; padding: 0; }
  .rx li { display: flex; justify-content: space-between; gap: 1rem; padding: .55rem 0; border-bottom: 1px solid var(--ink-3); }
  .rx b { font-family: var(--font-mono); color: var(--acid); }
</style>
