---
import Shell from '../layouts/Shell.astro';
import { INTENSITIES, INTENSITY_META } from '../data/exercises';
import {
  SESSION_COOKIE, SESSION_DAYS, hashPassword, verifyPassword, newToken,
  validateHandle, validatePassword,
} from '../lib/auth';
import { createSession, createUser, findUserByHandle, redeemInvite } from '../lib/db';
import { weekKey } from '../lib/scoring';

const user = Astro.locals.user;
const db = Astro.locals.runtime?.env?.DB;

let error: string | null = null;
let mode: 'login' | 'signup' = Astro.url.searchParams.get('join') !== null ? 'signup' : 'login';

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'login');
  const handleRaw = String(form.get('handle') ?? '');
  const password = String(form.get('password') ?? '');
  mode = intent === 'signup' ? 'signup' : 'login';

  if (intent === 'signup') {
    const code = String(form.get('code') ?? '');
    const h = validateHandle(handleRaw);
    const p = validatePassword(password);

    if (!h.ok) error = h.error;
    else if (!p.ok) error = p.error;
    else if (await findUserByHandle(db, h.handle)) error = 'That stage name is taken. Pick another.';
    else if (!(await redeemInvite(db, code))) error = "That invite code isn't on the list.";
    else {
      const { hash, salt } = await hashPassword(password);
      const id = await createUser(db, { handle: h.handle, hash, salt });
      const token = newToken();
      await createSession(db, id, token, SESSION_DAYS);
      Astro.cookies.set(SESSION_COOKIE, token, {
        path: '/', httpOnly: true, sameSite: 'lax',
        secure: Astro.url.protocol === 'https:', maxAge: SESSION_DAYS * 86400,
      });
      return Astro.redirect('/', 303);
    }
  } else {
    const row = await findUserByHandle(db, handleRaw.trim());
    if (!row || !(await verifyPassword(password, row.password_hash, row.salt))) {
      error = 'Wrong stage name or password.';
    } else {
      const token = newToken();
      await createSession(db, row.id, token, SESSION_DAYS);
      Astro.cookies.set(SESSION_COOKIE, token, {
        path: '/', httpOnly: true, sameSite: 'lax',
        secure: Astro.url.protocol === 'https:', maxAge: SESSION_DAYS * 86400,
      });
      return Astro.redirect(Astro.url.searchParams.get('next') ?? '/', 303);
    }
  }
}

// Points banked this week, for the home stat strip.
let weekPoints = 0;
if (user && db) {
  const row = await db
    .prepare('SELECT COALESCE(SUM(points),0) AS p FROM workouts WHERE user_id = ? AND week_key = ?')
    .bind(user.id, weekKey())
    .first<{ p: number }>();
  weekPoints = Number(row?.p ?? 0);
}
---

<Shell bare={!user}>
  {user ? (
    <div class="stack" style="--flow: 1.75rem">
      <div class="rise">
        <p class="eyebrow">Tonight's</p>
        <h1 class="display chrome" style="font-size: var(--step-4)">Setlist</h1>
      </div>

      <dl class="stats rise">
        <div><dt class="meta">Rank</dt><dd>{user.rank.title}</dd></div>
        <div><dt class="meta">Streak</dt><dd>{user.streak} <small>{user.streak === 1 ? 'day' : 'days'}</small></dd></div>
        <div><dt class="meta">This week</dt><dd>{weekPoints.toLocaleString()} <small>pts</small></dd></div>
      </dl>

      <form class="stack rise" action="/setlist" method="get" style="--flow: 1.25rem">
        <fieldset class="picker">
          <legend class="eyebrow">How loud</legend>
          {INTENSITIES.map((key, i) => (
            <label class="level">
              <input type="radio" name="intensity" value={key} checked={i === 1} />
              <span class="level-body">
                <strong>{INTENSITY_META[key].label}</strong>
                <span class="meta">{INTENSITY_META[key].blurb}</span>
                <span class="mult">{INTENSITY_META[key].multiplier}×</span>
              </span>
            </label>
          ))}
        </fieldset>

        <label class="toggle">
          <input type="checkbox" name="cooldown" value="1" />
          <span>Add a cooldown stretch</span>
        </label>

        <button class="btn" type="submit">Build the setlist</button>
      </form>
    </div>
  ) : (
    <div class="splash stack" style="--flow: 1.5rem">
      <div>
        <p class="eyebrow">Three exercises. One setlist.</p>
        <h1 class="wordmark chrome">Appetite<br /><em>for</em><br />Contraction</h1>
        <p class="tagline">
          A push, a core, a lower. Pick how loud you want it, start the clock,
          and get your name on the billboard.
        </p>
      </div>

      <div class="bolt" aria-hidden="true">
        <svg viewBox="0 0 24 34" fill="currentColor"><path d="M14 0 2 19h7l-2 15 13-19h-7l3-15Z"/></svg>
      </div>

      {error && <p class="notice" role="alert">{error}</p>}

      <form method="post" class="panel stack" style="--flow: .9rem">
        <input type="hidden" name="intent" value={mode} />

        {mode === 'signup' && (
          <label class="field">
            <span>Invite code</span>
            <input name="code" required autocomplete="off" autocapitalize="characters" placeholder="On the guest list?" />
          </label>
        )}

        <label class="field">
          <span>Stage name</span>
          <input name="handle" required autocomplete="username" maxlength="24" />
        </label>

        <label class="field">
          <span>Password</span>
          <input
            name="password" type="password" required
            autocomplete={mode === 'signup' ? 'new-password' : 'current-password'}
            minlength="6"
          />
        </label>

        <button class="btn" type="submit">{mode === 'signup' ? 'Join the band' : 'Sign in'}</button>

        <p class="meta switch">
          {mode === 'signup'
            ? <>Already in? <a href="/">Sign in</a></>
            : <>Got a code? <a href="/?join">Join the band</a></>}
        </p>
      </form>
    </div>
  )}
</Shell>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.4rem + 11vw, 6rem);
    line-height: .82;
    text-transform: uppercase;
    letter-spacing: -.01em;
    margin-block: .2em .35em;
  }
  .wordmark em { font-size: .42em; font-style: italic; letter-spacing: .04em; }

  .tagline { color: var(--fg-mute); font-size: var(--step-1); text-wrap: pretty; max-width: 28ch; }

  .splash { padding-top: clamp(1.5rem, 8vh, 4rem); }
  .switch { text-align: center; }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .5rem;
    border-block: var(--rule);
    padding-block: .9rem;
  }
  .stats dd {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin: .15rem 0 0;
    color: var(--acid);
  }
  .stats small { font-family: var(--font-mono); font-size: .62em; color: var(--fg-faint); }

  .picker { border: 0; padding: 0; margin: 0; display: grid; gap: .5rem; }
  .picker legend { margin-bottom: .5rem; }

  .level { display: block; cursor: pointer; }
  .level input { position: absolute; opacity: 0; width: 0; height: 0; }
  .level-body {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0 .75rem;
    padding: .8rem 1rem;
    border: 2px solid var(--hairline);
    border-radius: 3px;
    background: rgba(7, 3, 15, .6);
    transition: border-color .15s, box-shadow .15s;
  }
  .level strong {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: .06em;
  }
  .level .meta { grid-column: 1; grid-row: 2; letter-spacing: .04em; text-transform: none; }
  .level .mult {
    grid-column: 2; grid-row: 1 / 3;
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--fg-faint);
  }
  .level input:checked + .level-body { border-color: var(--hot); box-shadow: var(--glow-hot); }
  .level input:checked + .level-body .mult { color: var(--acid); }
  .level input:focus-visible + .level-body { outline: 3px solid var(--acid); outline-offset: 3px; }

  .toggle { display: flex; align-items: center; gap: .6rem; cursor: pointer; }
  .toggle input { width: 1.3rem; height: 1.3rem; accent-color: var(--hot); }
</style>
