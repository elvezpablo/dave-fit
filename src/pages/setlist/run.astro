---
import Shell from '../../layouts/Shell.astro';
---

<Shell title="On stage">
  <div id="stage" class="stack" style="--flow: 1.4rem">
    <p class="empty" id="nothing" hidden>
      No setlist in progress. <a href="/">Build one</a>.
    </p>
  </div>
</Shell>

<style is:global>
  /* Global, not scoped: this page renders itself with innerHTML, so Astro's
     data-astro-cid attributes are never present on these nodes. Namespaced
     under #stage so it stays contained. */
  #stage .head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  #stage .now-stage { font-family: var(--font-display); font-size: var(--step-2); line-height: .95; text-transform: uppercase; padding-bottom: .06em; }
  #stage .target { font-family: var(--font-mono); font-size: var(--step-1); color: var(--acid); letter-spacing: .08em; text-align: center; }
  #stage .cues { margin: 0; padding-left: 1.1rem; color: var(--fg-mute); font-size: var(--step-0); }
  #stage .cues li + li { margin-top: .25rem; }
  #stage .counter { display: flex; align-items: center; justify-content: center; gap: 1.25rem; }
  #stage .counter button {
    width: 3.75rem; height: 3.75rem; flex: none;
    border-radius: 50%; border: 2px solid var(--ice);
    background: rgba(7,3,15,.7); color: var(--ice);
    font-family: var(--font-body); font-size: 2rem; line-height: 1;
    cursor: pointer; transition: box-shadow .15s, background .15s;
  }
  #stage .counter button:hover { box-shadow: var(--glow-ice); background: rgba(34,231,255,.12); }
  #stage .counter button:active { transform: scale(.94); }
  #stage .counter output {
    font-family: var(--font-mono); font-size: var(--step-3); line-height: 1;
    min-width: 3ch; text-align: center; color: var(--acid);
    text-shadow: 0 0 14px rgba(216,255,46,.5);
  }
  #stage .row { display: flex; gap: .6rem; }
  #stage .row .btn { flex: 1; }
  #stage .ghosts { margin-top: -.6rem; }
  #stage .ghosts .btn-ghost { flex: 1; width: auto; }
  #stage .art { max-width: 20rem; margin-inline: auto; cursor: pointer; }
  #stage .phase-note { text-align: center; }
  #stage .rep-dots { margin-block: .25rem; }

  /* The set clock in reps mode is a passenger, not the headline — same ring,
     shrunk down so it doesn't shove the photos off the fold. */
  #stage .clock.is-mini .clock-ring { width: 5.5rem; height: 5.5rem; }
  #stage .clock.is-mini .clock-ring circle { stroke-width: 9; }
  #stage .clock.is-mini .clock-time { font-size: var(--step-1); }

  /* A running clock breathes; a paused one goes flat and says so. */
  #stage .clock[data-state='run'] .clock-time { animation: tick-pulse 1s steps(1) infinite; }
  #stage .clock[data-state='hold'] { opacity: .55; }
  #stage .clock[data-state='hold'] .clock-fill { filter: none; }
  @keyframes tick-pulse { 0%, 60% { opacity: 1; } 61%, 100% { opacity: .82; } }
  @media (prefers-reduced-motion: reduce) {
    #stage .clock[data-state='run'] .clock-time { animation: none; }
  }
</style>

<script>
  type Track = {
    slug: string; stage: string; real: string; bucket: string;
    mode: 'reps' | 'hold'; perSide: boolean; sets: number; target: number;
    restSec: number; photos: string[]; actual: number; setsDone: number;
  };
  type Live = {
    id: string; intensity: string; startedAt: string;
    ti: number; si: number; tracks: Track[];
  };

  const KEY = 'afc:live';
  const root = document.getElementById('stage')!;
  const raw = sessionStorage.getItem(KEY);

  if (!raw) {
    document.getElementById('nothing')!.hidden = false;
  } else {
    run(JSON.parse(raw) as Live);
  }

  function run(live: Live) {
    const save = () => sessionStorage.setItem(KEY, JSON.stringify(live));
    const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.max(0, Math.floor(s) % 60)).padStart(2, '0')}`;

    // Short tone at the end of a countdown. Cheap, no asset to load.
    // One context for the whole session — a new one per beep leaks on iOS.
    let ac: AudioContext | undefined;
    function beep(freq = 660, ms = 160) {
      try {
        ac ??= new AudioContext();
        if (ac.state === 'suspended') void ac.resume();
        const osc = ac.createOscillator();
        const gain = ac.createGain();
        osc.frequency.value = freq;
        osc.type = 'square';
        gain.gain.setValueAtTime(0.06, ac.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, ac.currentTime + ms / 1000);
        osc.connect(gain).connect(ac.destination);
        osc.start();
        osc.stop(ac.currentTime + ms / 1000);
      } catch { /* no audio, no problem */ }
    }

    // ── photos ───────────────────────────────────────────────────────────
    // The frames in a stack are the same movement from different angles, so
    // cycling them reads as the exercise rather than a still. Runs on every
    // screen that shows art, and goes still whenever the clock does.
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;

    function mountFlip() {
      const imgs = [...root.querySelectorAll<HTMLImageElement>('.photo-stack img')];
      let i = 0;
      let spin: number | undefined;

      const step = () => {
        imgs[i]?.removeAttribute('data-on');
        i = (i + 1) % imgs.length;
        imgs[i]?.setAttribute('data-on', '');
      };
      const start = () => {
        if (REDUCED || imgs.length < 2) return;
        spin ??= setInterval(step, 900) as unknown as number;
      };
      const stop = () => { clearInterval(spin); spin = undefined; };

      // Tap the photo to freeze a frame you want to study, tap again to resume.
      root.querySelector('.art')?.addEventListener('click', () => (spin ? stop() : start()));
      start();
      return { start, stop };
    }

    // ── the clock ────────────────────────────────────────────────────────
    type Clock = {
      elapsed: () => number;
      started: () => boolean;
      stop: () => void;
      toggle: () => void;
      reset: () => void;
    };
    /** The clock on screen right now, so keys and screen changes can reach it. */
    let active: Clock | undefined;
    let flip: { start: () => void; stop: () => void } | undefined;

    /** Tear down whatever is running before a screen is replaced. */
    function teardown() {
      active?.stop();
      active = undefined;
      flip?.stop();
      flip = undefined;
    }

    const ring = (sec: number, mini = false) => `
      <div class="clock${mini ? ' is-mini' : ''}" data-phase="early" data-state="idle">
        <svg class="clock-ring" viewBox="0 0 160 160" aria-hidden="true">
          <circle class="clock-track" cx="80" cy="80" r="70"></circle>
          <circle class="clock-fill" cx="80" cy="80" r="70"
                  stroke-dasharray="${2 * Math.PI * 70}" stroke-dashoffset="0"></circle>
        </svg>
        <output class="clock-time" aria-live="off">${mmss(sec)}</output>
      </div>`;

    /**
     * Wires the `.clock` just rendered into `root` to `#t-main` (start, then
     * pause/resume) and `#t-reset`. Time is measured from the wall clock, not
     * counted in ticks, so a locked phone or a backgrounded tab comes back
     * showing the truth.
     *
     * `down` counts a hold to zero and calls `onDone`; `up` is an open
     * stopwatch whose ring sweeps once a minute.
     */
    function mountClock(opts: {
      total: number;
      mode: 'down' | 'up';
      startLabel: string;
      autostart?: boolean;
      onState?: (s: { running: boolean; started: boolean }) => void;
      onDone?: () => void;
    }): Clock {
      const wrap = root.querySelector<HTMLElement>('.clock');
      const fill = root.querySelector<SVGCircleElement>('.clock-fill');
      const time = root.querySelector<HTMLElement>('.clock-time');
      const main = root.querySelector<HTMLButtonElement>('#t-main');
      const resetBtn = root.querySelector<HTMLButtonElement>('#t-reset');
      const CIRC = 2 * Math.PI * 70;

      // Painted every 100ms, so the CSS transition would only ever lag it.
      if (fill) fill.style.transition = 'stroke .6s ease';

      let banked = 0;            // ms from runs before the current one
      let since: number | null = null; // wall-clock start of the current run
      let ticker: number | undefined;
      let started = false;
      let finished = false;
      let lastBeep = -1;

      const ms = () => banked + (since === null ? 0 : Date.now() - since);
      const running = () => since !== null;

      function paint() {
        const secs = ms() / 1000;
        const shown = opts.mode === 'down' ? Math.max(0, opts.total - secs) : secs;
        if (time) time.textContent = mmss(opts.mode === 'down' ? Math.ceil(shown) : Math.floor(shown));

        // Counting down, the ring drains and cools off as time runs out;
        // counting up, it sweeps and warms once a minute.
        const frac = opts.mode === 'down'
          ? (opts.total > 0 ? shown / opts.total : 0)
          : (shown % 60) / 60;
        if (fill) fill.style.strokeDashoffset = String(CIRC * (1 - frac));
        wrap?.setAttribute(
          'data-phase',
          opts.mode === 'down'
            ? (frac > 0.55 ? 'early' : frac > 0.25 ? 'mid' : 'late')
            : (frac < 0.45 ? 'early' : frac < 0.8 ? 'mid' : 'late'),
        );
        wrap?.setAttribute('data-state', running() ? 'run' : started ? 'hold' : 'idle');
      }

      function paintControls() {
        if (main && !finished) main.textContent = running() ? 'Pause' : started ? 'Resume' : opts.startLabel;
        if (resetBtn) resetBtn.disabled = !started;
        opts.onState?.({ running: running(), started });
      }

      function frame() {
        paint();
        if (opts.mode !== 'down') return;
        const left = Math.ceil(opts.total - ms() / 1000);
        if (left <= 3 && left > 0 && left !== lastBeep) { lastBeep = left; beep(520, 90); }
        if (ms() / 1000 >= opts.total) {
          finished = true;
          stop();
          paint();
          beep(880, 320);
          opts.onDone?.();
        }
      }

      function start() {
        if (finished || running()) return;
        since = Date.now();
        started = true;
        ticker ??= setInterval(frame, 100) as unknown as number;
        flip?.start();
        paint();
        paintControls();
      }

      function pause() {
        if (!running()) return;
        banked = ms();
        since = null;
        clearInterval(ticker);
        ticker = undefined;
        flip?.stop();
        paint();
        paintControls();
      }

      function stop() { clearInterval(ticker); ticker = undefined; since = null; }

      function reset() {
        stop();
        banked = 0;
        started = false;
        lastBeep = -1;
        flip?.start();
        paint();
        paintControls();
      }

      main?.addEventListener('click', () => (running() ? pause() : start()));
      resetBtn?.addEventListener('click', reset);

      paint();
      paintControls();
      if (opts.autostart) start();

      return { elapsed: () => ms() / 1000, started: () => started, stop, reset, toggle: () => (running() ? pause() : start()) };
    }

    // Desk-friendly: space works the main button, R resets — but only when
    // nothing is focused, so tapping a real button still does its own job.
    document.addEventListener('keydown', (e) => {
      if (!active || e.target !== document.body || e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === ' ') { e.preventDefault(); active.toggle(); }
      else if (e.key === 'r' || e.key === 'R') { e.preventDefault(); active.reset(); }
    });

    /**
     * The control bar every screen ends with: one headline action on its own
     * row, the clock's smaller controls under it. `#t-main` and `#t-reset`
     * are what `mountClock` binds to, wherever in the bar they sit.
     */
    const controls = (main: string, ghosts = '') => `
      <div class="row">${main}</div>
      <div class="row ghosts">
        ${ghosts}
        <button class="btn btn-ghost" id="t-reset" type="button" disabled>Reset</button>
      </div>`;

    const art = (t: Track) =>
      t.photos.length
        ? `<div class="art"><figure class="photo-frame"><div class="photo-stack">${t.photos
            .slice(0, 6)
            .map((p, n) => `<img src="/ex/${p}-480.webp" alt="${n ? '' : t.real}" ${n ? 'aria-hidden="true"' : 'data-on'}>`)
            .join('')}</div></figure></div>`
        : '';

    const dots = (t: Track) =>
      `<div class="rep-dots" role="img" aria-label="Set ${t.setsDone + 1} of ${t.sets}">${Array.from(
        { length: t.sets },
        (_, i) => `<span class="rep-dot" ${i < t.setsDone ? 'data-done' : ''}></span>`,
      ).join('')}</div>`;

    const header = (t: Track, i: number) => `
      <div class="head">
        <div>
          <p class="eyebrow">Track ${i + 1} of ${live.tracks.length}</p>
          <h1 class="now-stage chrome">${t.stage}</h1>
          <p class="real-name">${t.real}${t.perSide ? ' · each side' : ''}</p>
        </div>
        <span class="bucket-tag" data-bucket="${t.bucket}">${t.bucket}</span>
      </div>`;

    function finish() {
      teardown();
      sessionStorage.setItem('afc:done', JSON.stringify(live));
      sessionStorage.removeItem(KEY);
      location.href = '/setlist/done';
    }

    function advance() {
      const t = live.tracks[live.ti]!;
      if (live.si < t.sets) return showWork();
      if (live.ti < live.tracks.length - 1) { live.ti++; live.si = 0; save(); return showWork(); }
      finish();
    }

    /** Bank a finished set and move on — the one exit every screen shares. */
    function bank(t: Track, amount: number) {
      t.actual += Math.max(0, Math.round(amount));
      t.setsDone++;
      live.si++;
      save();
      live.si < t.sets || live.ti < live.tracks.length - 1 ? showRest(t.restSec) : finish();
    }

    /** Rest between sets. Skippable — nobody wants to be held hostage. */
    function showRest(sec: number) {
      const next = live.tracks[live.si >= live.tracks[live.ti]!.sets ? Math.min(live.ti + 1, live.tracks.length - 1) : live.ti]!;
      teardown();
      root.innerHTML = `
        <p class="eyebrow phase-note">Intermission</p>
        ${ring(sec)}
        <p class="meta phase-note">Up next · ${next.stage}</p>
        ${art(next)}
        ${controls(
          '<button class="btn btn-ice" id="skip" type="button">Skip the break</button>',
          '<button class="btn btn-ghost" id="t-main" type="button">Pause</button>',
        )}`;
      flip = mountFlip();
      active = mountClock({ total: sec, mode: 'down', startLabel: 'Start the break', autostart: true, onDone: advance });
      document.getElementById('skip')!.onclick = () => { teardown(); advance(); };
    }

    function showWork() {
      const t = live.tracks[live.ti]!;
      save();
      teardown();

      if (t.mode === 'hold') {
        root.innerHTML = `
          ${header(t, live.ti)}
          ${dots(t)}
          ${ring(t.target)}
          <p class="target">Hold ${mmss(t.target)}</p>
          ${art(t)}
          <ul class="cues" id="cues"></ul>
          ${controls(
            '<button class="btn btn-ice" id="t-main" type="button">Start the hold</button>',
            '<button class="btn btn-ghost" id="bail" type="button" disabled>Call it</button>',
          )}`;
        cues(t);
        flip = mountFlip();

        // Pausing a hold needs a way out that isn't "wait out a clock you
        // already quit on" — bank whatever you actually held.
        const bail = document.getElementById('bail') as HTMLButtonElement;
        const clock = mountClock({
          total: t.target,
          mode: 'down',
          startLabel: 'Start the hold',
          onState: (s) => { bail.disabled = !s.started; },
          onDone: () => bank(t, t.target),
        });
        active = clock;
        bail.onclick = () => { teardown(); bank(t, clock.elapsed()); };
      } else {
        root.innerHTML = `
          ${header(t, live.ti)}
          ${dots(t)}
          <p class="target">Target ${t.target} reps${t.perSide ? ' each side' : ''}</p>
          <div class="counter">
            <button type="button" id="down" aria-label="One fewer rep">−</button>
            <output id="count" aria-live="polite">${t.target}</output>
            <button type="button" id="up" aria-label="One more rep">+</button>
          </div>
          ${ring(0, true)}
          ${art(t)}
          <ul class="cues" id="cues"></ul>
          ${controls(
            '<button class="btn" id="t-done" type="button">Set done</button>',
            '<button class="btn btn-ghost" id="t-main" type="button">Start timer</button>',
          )}`;
        cues(t);
        flip = mountFlip();

        // The rep set's clock is optional — it times you, it doesn't gate you.
        active = mountClock({ total: 0, mode: 'up', startLabel: 'Start timer' });

        let n = t.target;
        const out = document.getElementById('count')!;
        const set = (v: number) => { n = Math.max(0, Math.min(999, v)); out.textContent = String(n); };
        document.getElementById('up')!.onclick = () => set(n + 1);
        document.getElementById('down')!.onclick = () => set(n - 1);
        document.getElementById('t-done')!.onclick = () => { teardown(); bank(t, n); };
      }
    }

    // Cues come from the catalog, fetched once and cached by the service worker.
    async function cues(t: Track) {
      try {
        const res = await fetch('/api/catalog.json');
        const cat = await res.json();
        const hit = cat.find((e: any) => e.slug === t.slug);
        const ul = document.getElementById('cues');
        if (hit && ul) ul.innerHTML = hit.cues.map((c: string) => `<li>${c}</li>`).join('');
      } catch { /* offline and uncached — the photos still carry the idea */ }
    }

    showWork();
  }
</script>
