---
import Shell from '../layouts/Shell.astro';
import { workoutHistory } from '../lib/db';
import { BY_SLUG } from '../data/exercises';
import { INTENSITY_META } from '../data/exercises';

const user = Astro.locals.user!;
const db = Astro.locals.runtime?.env?.DB;
const history = db ? await workoutHistory(db, user.id, 25) : [];
const r = user.rank;
---

<Shell title={user.handle}>
  <div class="stack" style="--flow: 1.5rem">
    <header>
      <p class="eyebrow">{r.title}</p>
      <h1 class="display chrome">{user.handle}</h1>
    </header>

    <div class="panel stack" style="--flow: .8rem">
      <dl class="stats">
        <div><dt class="meta">Lifetime</dt><dd>{user.stats.lifetime_points.toLocaleString()}</dd></div>
        <div><dt class="meta">Shows</dt><dd>{user.stats.workout_count}</dd></div>
        <div><dt class="meta">Streak</dt><dd>{user.streak}</dd></div>
        <div><dt class="meta">Best</dt><dd>{user.stats.longest_streak}</dd></div>
      </dl>

      {r.next && (
        <div>
          <div class="bar"><span style={`width:${Math.round(r.progress * 100)}%`}></span></div>
          <p class="meta">{r.next.remaining.toLocaleString()} points to {r.next.title}</p>
        </div>
      )}
    </div>

    <section class="stack" style="--flow: .6rem">
      <h2 class="eyebrow">Tour history</h2>
      {history.length === 0 ? (
        <p class="empty">No shows played. <a href="/">Build a setlist</a>.</p>
      ) : (
        <ul class="shows">
          {history.map((w) => (
            <li>
              <div>
                <p class="when">{w.local_date}</p>
                <p class="meta">
                  {INTENSITY_META[w.intensity]?.label ?? w.intensity} ·{' '}
                  {w.slugs.map((s) => BY_SLUG.get(s)?.stage ?? s).join(' / ')}
                </p>
              </div>
              <span class="pts">+{w.points.toLocaleString()}</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <form method="post" action="/api/auth/logout">
      <button class="btn btn-ghost" type="submit" style="width:100%">Sign out</button>
    </form>
  </div>
</Shell>

<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; }
  .stats dd { font-family: var(--font-display); font-size: var(--step-1); margin: .1rem 0 0; color: var(--acid); }
  .bar { height: .6rem; border: 2px solid var(--hairline); border-radius: 99px; overflow: hidden; margin-bottom: .35rem; }
  .bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--ice), var(--hot)); box-shadow: var(--glow-hot); }
  .shows { list-style: none; margin: 0; padding: 0; border-top: var(--rule); }
  .shows li { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-bottom: var(--rule); }
  .when { font-family: var(--font-mono); font-size: var(--step-0); }
  .shows .meta { text-transform: none; letter-spacing: .02em; }
  .pts { font-family: var(--font-mono); color: var(--acid); white-space: nowrap; }
</style>
