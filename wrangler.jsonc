{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dave-fit",
	"main": "./dist/_worker.js/index.js",
	"compatibility_date": "2025-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dave-fit",
			"database_id": "5c2c5949-799d-401d-86f6-a8f69a7765e9"
		}
	],
	"observability": {
		"enabled": true
	}
	// Custom domain — uncomment and set once the hostname is decided:
	// "routes": [{ "pattern": "shred.example.com", "custom_domain": true }]
}
